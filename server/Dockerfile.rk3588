# RK3588 runtime: pinned Rockchip FFmpeg, MPP/RGA and matching Mali OpenCL.
FROM --platform=$BUILDPLATFORM node:24-alpine AS frontend-builder
ENV NODE_USE_ENV_PROXY=1
WORKDIR /src/frontend
COPY frontend/package.json frontend/pnpm-lock.yaml frontend/pnpm-workspace.yaml ./
COPY frontend/patches/ ./patches/
RUN corepack enable && corepack prepare pnpm@10.33.4 --activate && pnpm install --frozen-lockfile
COPY frontend/ ./
RUN pnpm build

FROM --platform=$BUILDPLATFORM golang:1.25-alpine AS backend-builder
ARG TARGETOS
ARG TARGETARCH
RUN apk add --no-cache git
ENV GOPROXY=https://goproxy.cn,direct
WORKDIR /src
COPY backend/go.mod backend/go.sum ./
RUN go mod download
COPY backend/ ./
RUN rm -rf ./frontend/dist
COPY --from=frontend-builder /src/frontend/dist/ ./frontend/dist/
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -ldflags="-s -w" -o filebrowser .

FROM jellyfin/jellyfin:10.11.11@sha256:7536c1009c6ea50dadd2b244165efb357504ca0f2670abefbceb1c773cc7e13d
ARG IMAGE_VERSION=unknown
ARG IMAGE_REVISION=unknown
ARG IMAGE_CREATED=unknown
LABEL org.opencontainers.image.title="Fileway" \
      org.opencontainers.image.version="${IMAGE_VERSION}" \
      org.opencontainers.image.revision="${IMAGE_REVISION}" \
      org.opencontainers.image.created="${IMAGE_CREATED}"
RUN apt-get update && apt-get install -y --no-install-recommends tini busybox-static media-types \
    && ln -s /bin/busybox /usr/local/bin/wget && rm -rf /var/lib/apt/lists/*
ENV PATH="/usr/lib/jellyfin-ffmpeg:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
COPY --from=backend-builder /src/filebrowser /usr/local/bin/filebrowser
COPY docker/common/ /
COPY docker/alpine/ /
COPY docker/JSON.sh /JSON.sh
RUN chmod +x /healthcheck.sh /init.sh /JSON.sh && mkdir -p /config /database /srv
WORKDIR /srv
EXPOSE 80
HEALTHCHECK --start-period=2m --interval=30m --timeout=3s --retries=2 CMD /healthcheck.sh
ENTRYPOINT ["/usr/bin/tini", "--", "/init.sh"]
CMD []
