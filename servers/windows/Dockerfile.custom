# ============================================================
# NAS File Browser - Build with New Frontend
# ============================================================

# --- Stage 1: Build Frontend ---
FROM --platform=$BUILDPLATFORM node:24-alpine AS frontend-builder

ENV NODE_USE_ENV_PROXY=1

WORKDIR /src/frontend

COPY frontend/package.json frontend/pnpm-lock.yaml frontend/pnpm-workspace.yaml ./
COPY frontend/patches/ ./patches/

RUN corepack enable && \
    corepack prepare pnpm@10.33.4 --activate && \
    pnpm install --frozen-lockfile

COPY frontend/ ./

RUN pnpm build

# --- Stage 2: Build Backend ---
FROM --platform=$BUILDPLATFORM golang:1.25-alpine AS backend-builder

ARG TARGETOS
ARG TARGETARCH

RUN apk add --no-cache git

ENV GOPROXY=https://goproxy.cn,direct

WORKDIR /src

COPY backend/go.mod backend/go.sum ./
RUN go mod download

COPY backend/ ./

RUN rm -rf ./frontend/dist
COPY --from=frontend-builder /src/frontend/dist/ ./frontend/dist/

RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build -ldflags="-s -w" -o filebrowser .

# --- Stage 3: Runtime ---
FROM alpine:3.23

RUN apk add --no-cache ca-certificates mailcap tini ffmpeg

COPY --from=backend-builder /src/filebrowser /usr/local/bin/filebrowser
COPY docker/common/ /
COPY docker/alpine/ /
COPY docker/JSON.sh /JSON.sh
RUN chmod +x /healthcheck.sh /init.sh /JSON.sh

RUN mkdir -p /config /database /srv

VOLUME /config /database

EXPOSE 80

HEALTHCHECK --start-period=2m --start-interval=5s --interval=30m --timeout=3s --retries=2 CMD /healthcheck.sh

ENTRYPOINT ["tini", "--", "/init.sh"]
