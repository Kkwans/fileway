<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <application android:allowAudioPlaybackCapture="true">
        <activity android:name=".EngineProbeActivity" android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout" />
        <!-- Diagnostic variant only. Foregrounding requires the caller to hold
             the platform DUMP permission, verified on the owned ADB shell. -->
        <activity android:name=".AudioCaptureProbeActivity" android:exported="true"
            android:permission="android.permission.DUMP"
            android:configChanges="orientation|screenSize|screenLayout" />
        <service android:name=".PlaybackCaptureProbeService" android:exported="false"
            android:foregroundServiceType="mediaProjection" />
    </application>
</manifest>
